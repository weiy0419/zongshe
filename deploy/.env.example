# ============================================
# 云服务器部署环境变量（复制为 deploy/.env 后修改）
# ============================================

# 对外 HTTP 端口（手机/浏览器访问）
HTTP_PORT=80

# MySQL
MYSQL_ROOT_PASSWORD=请修改为强密码
MYSQL_DATABASE=zongshe

# 后端数据库连接（Docker 内部网络）
DB_URL=jdbc:mysql://mysql:3306/zongshe?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=请修改为强密码

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ（管理台 http://localhost:15672 ，账号需与下面两项一致）
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# 管理员与 JWT（生产环境务必修改）
ADMIN_USERNAME=yunizai
ADMIN_PASSWORD=请修改为强密码
ADMIN_NAME=管理员
JWT_SECRET=请替换为至少32位随机字符串
JWT_EXPIRATION=7200

# 可选：限制 CORS 来源（逗号分隔，留空则允许同源）
# CORS_ALLOWED_ORIGINS=https://your-domain.com
